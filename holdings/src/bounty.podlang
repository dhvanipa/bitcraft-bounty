/*
  bounty: a claim that the prover holds unspent Bitcraft gems worth at least
  `threshold` BIT at one state root, made for `recipient`.

  BountyClaim(state_header, recipient, threshold) says the prover knows object
  states, each with a different tag, such that each one

  - is live at `state_header` (holdings.podlang's LiveObject): in its created
    array, so a valid transaction made it, and unspent there, its nullifier
    absent from its nullifier set;
  - is a gem: H(obj.type, value) is in GEM_VALUES, which holds one entry per
    gem class of the Bitcraft plugin (module 0x54548dac8ef1...), its
    `Is<Class>` predicate hash with its value in BIT (LiveGem);

  and their values add up to at least `threshold` (GemsTotal). The tag
  (LiveObject's) is the same for every state of one object, so no object
  counts twice. `recipient` is the address
  the bounty pays: it is part of the statement, so a copied proof pays the
  same address.

  GEM_VALUES is filled in by bounty.rs from its GEMS table, and
  HOLDINGS_MODULE (holdings.podlang's hash) by live.rs.
*/

use module HOLDINGS_MODULE as holdings

LiveGem(state_header holdings::StateHeader, value, tag, private: obj, entry) = AND(
  holdings::LiveObject(state_header, obj, tag)
  Hash(obj.type, value, entry)
  SetContains(GEM_VALUES, entry)
)

// The total value of a set of live gems with distinct tags.
GemsTotal(state_header holdings::StateHeader, total, tags) = OR(
  GemsTotalOne(state_header, total, tags)
  GemsTotalMore(state_header, total, tags)
)

GemsTotalOne(state_header holdings::StateHeader, total, tags, private: tag) = AND(
  LiveGem(state_header, total, tag)
  SetInsert({}, tag, tags)
)

// SetInsert requires the tag's prior absence: no object counts twice.
GemsTotalMore(state_header holdings::StateHeader, total, tags,
    private: prev_total, prev_tags, value, tag) = AND(
  GemsTotal(state_header, prev_total, prev_tags)
  LiveGem(state_header, value, tag)
  Sum(prev_total, value, total)
  SetInsert(prev_tags, tag, tags)
)

BountyClaim(state_header holdings::StateHeader, recipient, threshold, private: total, tags) = AND(
  GemsTotal(state_header, total, tags)
  GtEq(total, threshold)
  Equal(recipient, recipient)
)
