+    /// A proof for each nullifier against the spent set at `roots.nullifiers`:
+    /// `(true, proof of presence)` when it is spent, `(false, proof of
+    /// absence)` otherwise. A proof of absence is what lets a holder prove an
+    /// object state is unspent at this root. The set is opened once for the
+    /// whole batch.
+    pub fn prove_nullifiers_for(
+        &self,
+        roots: &StateRoots,
+        nullifiers: &[Hash],
+    ) -> Result<Vec<(bool, MerkleProof)>> {
+        let nullifier_set = self.open_nullifiers(roots.nullifiers)?;
+        nullifiers
+            .iter()
+            .map(|hash| {
+                let value = Value::from(*hash);
+                if nullifier_set.contains(&value).map_err(|err| anyhow!("{err}"))? {
+                    let proof = nullifier_set.prove(&value).map_err(|err| anyhow!("{err}"))?;
+                    Ok((true, proof))
+                } else {
+                    let proof = nullifier_set
+                        .prove_nonexistence(&value)
+                        .map_err(|err| anyhow!("{err}"))?;
+                    Ok((false, proof))
+                }
+            })
+            .collect()
+    }
