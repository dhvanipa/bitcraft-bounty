+    #[test]
+    fn test_nullifier_proofs_of_presence_and_absence() {
+        let (containers, _dir) = open_test_db();
+        let mut nullifiers = containers.open_nullifiers(EMPTY_HASH).unwrap();
+        let spent = test_hash(3);
+        nullifiers.insert(&Value::from(spent)).unwrap();
+        nullifiers.insert(&Value::from(test_hash(4))).unwrap();
+        let root = nullifiers.commitment();
+        let roots = StateRoots {
+            nullifiers: root,
+            ..StateRoots::empty()
+        };
+
+        let unspent = test_hash(5);
+        let proofs = containers
+            .prove_nullifiers_for(&roots, &[spent, unspent])
+            .unwrap();
+        assert!(proofs[0].0, "a spent nullifier is reported spent");
+        Set::verify(root, &proofs[0].1, &Value::from(spent)).unwrap();
+        assert!(!proofs[1].0, "an unspent nullifier is reported unspent");
+        Set::verify_nonexistence(root, &proofs[1].1, &Value::from(unspent)).unwrap();
+        // the proof of absence does not prove the spent one absent
+        assert!(Set::verify_nonexistence(root, &proofs[1].1, &Value::from(spent)).is_err());
+    }
