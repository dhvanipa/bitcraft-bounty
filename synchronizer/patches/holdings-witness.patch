+/// Request for `POST /v1/holdings/witness`.
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct HoldingsWitnessRequest {
+    /// Execution block of the state to answer against, as `/v1/state/by_el`
+    /// takes it; the head state when absent.
+    #[serde(default)]
+    block_number: Option<i64>,
+    #[serde(default)]
+    object_commitments: Vec<Hash>,
+    #[serde(default)]
+    nullifiers: Vec<Hash>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct NullifierProofResponse {
+    nullifier: Hash,
+    /// Whether the nullifier is in the spent set, so its object state is spent.
+    spent: bool,
+    /// Merkle proof against the nullifiers root: of presence when `spent`, of
+    /// absence otherwise.
+    proof: MerkleProof,
+}
+
+/// Everything a holder needs to prove, against one state root, that object
+/// states were created and are unspent there: the state's header, an
+/// `ArrayContains` proof per commitment and a spent-set proof per nullifier.
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct HoldingsWitnessResponse {
+    state_root: Hash,
+    block_number: i64,
+    block_timestamp: i64,
+    block_hash: Hash,
+    created_root: Hash,
+    nullifiers_root: Hash,
+    prior_state_history_root: Hash,
+    created_proofs: Vec<ObjectProofResponse>,
+    nullifier_proofs: Vec<NullifierProofResponse>,
+}
+
+/// Proofs about object states against one state: the head, or the state
+/// derived at `blockNumber`, such as a root a contract was given. The
+/// grounding witness only answers against the head, and has no proof that a
+/// nullifier is absent.
+async fn post_holdings_witness(
+    State(app_state): State<AppState>,
+    Json(body): Json<HoldingsWitnessRequest>,
+) -> Result<Json<HoldingsWitnessResponse>, (StatusCode, String)> {
+    ensure_membership_query_limit(body.object_commitments.len(), body.nullifiers.len())?;
+    let (slot_state, indices) = match body.block_number {
+        None => {
+            let (head, indices) = app_state
+                .state_log
+                .slot_state_at_head_with_created_indices(&body.object_commitments)
+                .await
+                .map_err(internal_error)?;
+            (head.ok_or_else(not_initialized)?, indices)
+        }
+        Some(number) => {
+            let block = u64::try_from(number).map_err(|_| {
+                (
+                    StatusCode::BAD_REQUEST,
+                    format!("execution block number {number} is negative"),
+                )
+            })?;
+            let slot_state = app_state
+                .state_log
+                .slot_state_at_el_block(BlockHashOrNumber::Number(block))
+                .await
+                .map_err(internal_error)?
+                .ok_or_else(|| {
+                    (
+                        StatusCode::NOT_FOUND,
+                        format!("no state derived at execution block {number}"),
+                    )
+                })?;
+            // The index is a hint here too: prove_created_for checks the leaf
+            // at this state's own root, so a commitment created later is
+            // reported absent.
+            let indices = app_state
+                .state_log
+                .created_indices(&body.object_commitments)
+                .await
+                .map_err(internal_error)?;
+            (slot_state, indices)
+        }
+    };
+    let state = slot_state.state;
+    let containers = &app_state.containers;
+    let created = containers
+        .prove_created_for(&state.roots, &body.object_commitments, &indices)
+        .map_err(internal_error)?;
+    let nullified = containers
+        .prove_nullifiers_for(&state.roots, &body.nullifiers)
+        .map_err(internal_error)?;
+    let header = state.state_header();
+
+    Ok(Json(HoldingsWitnessResponse {
+        state_root: state.metadata.state_root,
+        block_number: header.block_number,
+        block_timestamp: header.block_timestamp,
+        block_hash: header.block_hash,
+        created_root: header.created_root,
+        nullifiers_root: header.nullifiers_root,
+        prior_state_history_root: header.prior_state_history_root,
+        created_proofs: body
+            .object_commitments
+            .into_iter()
+            .zip(created)
+            .map(|(commitment, witness)| {
+                let (index, proof) = witness.unzip();
+                ObjectProofResponse {
+                    commitment,
+                    present: index.is_some(),
+                    index,
+                    proof,
+                }
+            })
+            .collect(),
+        nullifier_proofs: body
+            .nullifiers
+            .into_iter()
+            .zip(nullified)
+            .map(|(nullifier, (spent, proof))| NullifierProofResponse {
+                nullifier,
+                spent,
+                proof,
+            })
+            .collect(),
+    }))
+}
